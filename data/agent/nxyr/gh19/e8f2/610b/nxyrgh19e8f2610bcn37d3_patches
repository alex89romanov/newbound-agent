{"data":{"list":[{"author":"migration","cmd":"","facet":"memory","label":"memory: Every LLM provider behind agent.llm's resolver accepts exactl...","new":"[\n  {\n    \"claim\": \"Every LLM provider behind agent.llm's resolver accepts exactly ONE system message, and it must be at index 0.\",\n    \"detail\": \"vLLM's chat template answers a system message at any later index — including index 1, ahead of every user turn — with a hard 400: BadRequestError \\\"System message must be at the beginning.\\\" So client-side context injection (recall layer 4's mode pack) must be APPENDED to the existing system message, never inserted beside it. Appending rather than prepending is also the cache-friendly choice: the curriculum stays a stable prefix, so server-side prefix caching still hits. agent.agentloop's chatTurn does this in convo(), which builds a merged COPY — the venue's own messages array is never mutated.\",\n    \"tags\": \"llm,agent,platform-api,wire\",\n    \"source\": {\n      \"lib\": \"agent\",\n      \"ctl\": \"agentloop\",\n      \"facet\": \"js\",\n      \"hash\": \"6569fbeed2ace744\"\n    },\n    \"confidence\": \"high\",\n    \"time\": 1785964641067\n  }\n]\n","old":"","patch_id":"p1","time":1786733933867}]},"id":"nxyrgh19e8f2610bcn37d3_patches","readers":[],"time":1786733933867,"username":"system","writers":[]}