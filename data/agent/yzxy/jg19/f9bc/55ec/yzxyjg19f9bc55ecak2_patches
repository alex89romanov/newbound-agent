something, tell them to enable the needed commands in the notebook's \"tools ▸\" picker — do not describe the lack of tools as a platform restriction or security policy.`;\n\n// Newbound meta types -> Rust types, for synthesized signatures (ported\n// from control_query's lookup_rust_api_data_type).\nconst RUST_TYPE = {\n  FLAT: \"DataObject\", JSONObject: \"DataObject\", JSONArray: \"DataArray\",\n  InputStream: \"DataBytes\", float: \"f64\", Integer: \"i64\", Boolean: \"bool\",\n  Any: \"Data\", NULL: \"DNull\",\n};\nconst rustType = (t) => RUST_TYPE[t] ?? \"String\";\n\n/** The context prompt, ported from control_query: an editing preamble plus\n    one fence per included piece, tagged the way the backend prompt always\n    tagged them. `included` = chatctx snapshot entries the user checked. */\nexport function contextBlock(included) {\n  const merged = {};\n  for (const p of included) Object.assign(merged, p.fields);\n  const { lib, ctl } = merged;\n  if (!lib && !ctl) return \"\";\n  let out = `We are editing the ${ctl} control in the ${lib} library.`;\n  for (const facet of [\"html\", \"css\", \"js\"]) {\n    const v = (merged[facet] ?? \"\").trim?.() ?? \"\";\n    if (v) out += `\\n\\n\\`\\`\\`${lib}:${ctl}.${facet}\\n${v}\\n\\`\\`\\``;\n  }\n  if (merged.code && merged.cmdname) {\n    const lang = merged.lang === \"rust\" ? \"rs\" : merged.lang === \"python\" ? \"py\" : merged.lang;\n    let signature = \"\";\n    if (merged.cmdparams) {\n      const ps = merged.cmdparams.map((p) =>\n        lang === \"rs\" ? `${p.name}: ${rustType(p.type)}` : p.name).join(\", \");\n      signature = lang === \"rs\"\n        ? `// fn ${merged.cmdname}(${ps}) -> ${rustType(merged.cmdreturn ?? \"String\")}\\n`\n        : `# def ${merged.cmdname}(${ps}):\\n`;\n    }\n    out += `\\n\\n\\`\\`\\`${lib}:${ctl}:${merged.cmdname}.${lang}\\n${signature}${merged.code.trim()}\\n\\`\\`\\``;\n  }\n  if (merged.flow && merged.cmdname) {\n    out += `\\n\\n\\`\\`\\`${lib}:${ctl}:${merged.cmdname}.flow\\n${merged.flow}\\n\\`\\`\\``;\n  }\n  return out;\n}\n\nexport const clamp = (s, n = 2000) =>\n  s.length <= n ? s : s.slice(0, n) + `\\n…[${s.length - n} chars clipped]`;\n\n/** MCP tool descriptors -> OpenAI function defs, enabled names only. */\nexport function toolDefs(mcpTools, enabledNames) {\n  const on = new Set(enabledNames);\n  return (mcpTools ?? [])\n    .filter((t) => on.has(t.name))\n    .map((t) => ({\n      type: \"function\",\n      function: {\n        name: t.name,\n        description: t.description ?? \"\",\n        parameters: t.inputSchema ?? { type: \"object\", properties: {} },\n      },\n    }));\n}\n\n/** \"lib-ctl-cmd\" -> {lib, ctl, cmd} (ctl may itself contain dashes). */\nexport function parseToolName(name) {\n  const parts = name.split(\"-\");\n  if (parts.length < 3) return null;\n  return { lib: parts[0], ctl: parts.slice(1, -1).join(\"-\"), cmd: parts.at(-1) };\n}\n\n/**\n * One conversational turn, driving chat_llm until it answers in text.\n * execTool(call) is the session's: it renders the cell, gates mutating\n * commands behind the typed confirm, runs it, and resolves the tool-result\n * CONTENT string (or a denial note). Returns the final text.\n */\nexport async function chatTurn({ messages, tools, execTool, onRound }) {\n  for (let round = 0; round < MAX_ROUNDS; round++) {\n    const r = await store.chatLlm(messages, tools);\n    if (r.status !== \"ok\") throw new Error(r.msg ?? \"chat_llm failed\");\n    const d = r.data ?? {};\n    if (d.kind !== \"tool_calls\") {\n      return d.content ?? \"\";\n    }\n    messages.push(d.assistant_message);\n    onRound?.(d.tool_calls);\n    for (const call of d.tool_calls) {\n      const content = await execTool(call);\n      messages.push({ role: \"tool\", tool_call_id: call.id, content });\n    }\n  }\n  return \"(stopped: the agent used its whole tool budget without a final answer)\";\n}\n","patch_id":"p4","time":1785059761683},{"author":"claude","facet":"move","label":"moved from bench to agent","new":"agent","old":"bench","patch_id":"p5","time":1785372127284},{"author":"claude","facet":"js","label":"tool names follow the write API to dev-code-*","new":"// agentloop.js — the client side of \"chat with the code\", the way the\n// owner called it (2026-07-25): skip control_query AND tool_loop, call\n// agent.llm.chat_llm directly. This module owns what control_query used to\n// do server-side — the system prompt, the context fences, the history —\n// plus the tool loop the notebook can actually SHOW: chat_llm returns\n// normalized tool_calls; the session renders each as a cell and gates\n// mutating ones behind its typed confirm before the loop continues.\n//\n// chat_llm contract (agent.llm, JSONObject envelope — payload under data):\n//   in:  messages (system/user/assistant/tool), tools (OpenAI function defs)\n//   out: {kind:\"text\", content, assistant_message}\n//      | {kind:\"tool_calls\", tool_calls:[{id,name,arguments(JSON string)}],\n//         assistant_message}   — assistant_message goes back on the list.\n// MCP tools (agent.plugin.list_tools) arrive as {name:\"lib-ctl-cmd\",\n// description, inputSchema} — inputSchema is a real JSON Schema.\n\nimport { store } from \"./store.js\";\n\n// Generous: the autonomous developer workflow legitimately spends rounds\n// on compile-debug cycles.\nexport const MAX_ROUNDS = 10;\n\n// The system prompt lives client-side now — the cost of skipping\n// control_query, and the point: the bench knows what the model is looking\n// at and how its replies get used. The platform-knowledge sections are\n// the owner's, folded in from agent.llm.tool_loop's prompt (his call:\n// without them the model can't write ndata-correct code or reason about\n// the platform). Model-agnostic (Qwen or Claude).\nexport const SYSTEM_PROMPT = `You are Newbound, a self-organizing collection of code, data, and opinions that is working with the humans to improve their way of life. Right now you are speaking through the session notebook of Bench, the Newbound IDE — the user sees every tool call you make as a notebook cell.\n\nYour capabilities are defined by the Commands in your flowlang DataStore. The datastore is organized into libraries. Libraries contain Assets and Controls. Controls contain UI elements (html/css/js/data/3d) and back-end components (Command/Event/Timer). The \\`app\\`, \\`dev\\`, \\`peer\\`, and \\`security\\` libraries are the core Newbound libraries. They are great reference information because they define how everything in Newbound is done.\n\nThe ndata Crate: The Universal Data Layer\nAdherence to the principles of the underlying ndata crate is crucial for writing correct and performant rust code. All data within the Flowlang runtime, between the front-end and back-end, and within Commands is managed by ndata.\n  Core Concept: ndata provides globally shared, thread-safe, JSON-like dynamic data structures: DataObject (a HashMap), DataArray (a Vec), and DataBytes (a byte stream). These are handles to heap-stored data.\n  CRITICAL RULE — NO WRAPPING: ndata types are already internally thread-safe. NEVER wrap them in Arc, Rc, Mutex, RwLock, or any other synchronization primitive.\n  Handles: .clone() is cheap (a new handle, refcount bump). When you pass a handle to a mutator like parent.put_object(\"key\", child), the child handle is MOVED — clone first (child.clone()) if you need it afterward.\n  Best practices: prefer typed methods (get_string, put_object) over generic ones; DataObject::new() / DataArray::new() for new instances; deep_copy() for an independent duplicate.\n  SUPER IMPORTANT: ndata does NOT use the wrap-everything-in-Result pattern — get_object/get_int/get_string return directly or PANIC. Use try_get_XXX variants or check has(&key) first when absence is possible.\n\nThe flowlang Crate: The Runtime Engine\n  Data lives under ./data/<lib>/, sharded by four-character chunks of the record id: ./data/lib/[0..4]/[4..8]/[8..12]/[12..16]/fullid. A library's control index is data/<lib>/cont/rols/____/____/controls; its metadata is data/<lib>/meta.json; its assets are data/<lib>/_ASSETS/. It is UNWISE to edit these files directly — malformed data can crash Newbound; use platform commands, which are journaled.\n  STORAGE: use flowlang::datastore::DataStore; let store = DataStore::new(); let ctl = store.get_data(&lib, &id).get_object(\"data\");\n  GLOBALS: DataStore::globals().get_object(\"system\").get_object(\"libraries\")\n  EXECUTION: use flowlang::command::Command; let cmd = Command::lookup(lib, control, command); let result = cmd.execute(arguments);\n\nNewbound Web Apps\n  A Newbound Application is a Control with the same name as its library that has been published. Applications serve at /appname/index.html and their commands at /appname/cmdname?param=value. The http_port is in config.properties.\n\nWriting Commands in Rust\n  Default to Rust for new commands unless Python is explicitly requested or needed for an AI/data-science library.\n  CRITICAL — code_body IS A FUNCTION BODY, NOT A FUNCTION: for upsert_command/patch_command_body, your code_body is placed inside a generated fn: pub fn <cmd>(<params>) -> <ReturnType> { <your code_body> }. Never write a fn signature or outer braces. Declared params are in scope as typed variables (String, Integer→i64, Float→f64, Boolean→bool, JSONObject→DataObject, JSONArray→DataArray). The FINAL EXPRESSION must match the declared return_type. Put use statements in \\`imports\\`; DataObject is imported automatically.\n  Other Newbound commands are callable natively: let api = crate::api::new(); api.lib.ctl.cmd(param1, param2); or use crate::lib::ctl::cmd::cmd;\n\nWriting Commands in Python\n  Python is first-class: arguments arrive as NDataObject/NDataArray/NDataBytes wrappers sharing memory with Rust — manipulate them directly. Returning native Python types auto-converts.\n\nReturn Type Semantics\n  A command's response JSON always has \"status\" (\"ok\"/\"err\"). A returned String lands in \"msg\"; other types land in \"data\"; FLAT means the returned DataObject IS the outermost response. Choose return_type to match the final expression.\n\nFront-End Control Development (HTML/CSS/JS)\n  Platform controls keep html, css, and js as separate facets. A back-end command foo is exposed to that control's js as send_foo(args..., function(result){...}) — result.msg for Strings, result.data otherwise. jQuery 3.6.1 is loaded. Standard boilerplate: var me = this; var ME = $('#' + me.UUID)[0]; me.ready = function(){...}. Sub-controls mount declaratively (<div class='data-control' data-control='lib:ctl:{...}'>) or via installControl(...).\n  EXCEPTION: the \\`bench\\` library's own controls are ES modules (export function init(host, props), no jQuery, imports from ../../assets/) — match the style of whatever control you are editing.\n\nWHAT YOU SEE\n- Current code arrives in fenced blocks labeled lib:ctl.facet (facets) or lib:ctl:command.lang (command bodies; the first line may be a synthesized signature comment). A flow body arrives as JSON labeled lib:ctl:command.flow.\n- \"Recent notebook activity\" lists commands run in this session, with OUTPUTS TRUNCATED. Never conclude that something is absent because you don't see it in a truncated result — rerun the command via a tool when you need the full output.\n\nHOW TO ANSWER\n- Be concise and concrete. If you are unsure, say so plainly rather than inventing platform behavior.\n- To propose a facet change, reply with ONE complete fenced block per changed facet, tagged html, css, or js. The user can apply such a block as a journaled whole-facet patch in one click — a partial snippet cannot be applied, so always return the full facet.\n- Command-body suggestions: a fenced block tagged rust or python containing the full body.`;\n\n// The tool model (owner's design, 2026-07-25): DISCOVERY is always on,\n// ATTACHMENT is a context optimization, AUTHORIZATION happens per call.\nexport const TOOLS_PROMPT = `\n\nTOOLS\nNewbound commands are your tools, named library-control-command (e.g. dev-code-read_command). Call them through the tool-calling interface — never by describing a call in text. Every call you make appears as a cell in the user's notebook.\n\n- A core set is attached with full schemas. EVERY other platform command is also available: use find_tools(query) to discover commands for a task, describe_tool(name) for a full schema, and call_command(name, args) to invoke anything not directly attached. Never claim a capability is missing until find_tools says so.\n- Authorization is per call, not per tool: read-only commands run immediately; anything mutating or potentially destructive stops for the user's typed confirmation first — so do not hesitate to REQUEST a powerful command when the task needs it; the user decides at the moment of use. A denial is the user's decision: respect it and continue without that action.\n- Read before you write. For edits prefer the journaled, revertible commands: dev-code-patch_control_facet for UI facets, dev-code-patch_command_body / upsert_command for command bodies, dev-code-read_flow_body / write_flow_body for flow commands.\n\nThe Autonomous Developer Workflow\nWhen asked to build a feature, process data, or perform a task requiring code, act as an autonomous developer:\n1. READ: understand existing code first (dev-code-read_command, dev-code-read_control_facet).\n2. WRITE: dev-code-upsert_command or dev-code-patch_command_body — the system generates the source, compiles, and hot-swaps on success.\n3. DEBUG: if compilation fails, do not apologize — read the compiler error from the tool result, patch, and compile again until it succeeds.\n4. EXECUTE: dev-code-invoke_command to run and verify.\n5. RESPOND: give your final answer only after execution succeeds, summarizing what you built and the results.\n6. OBSTACLES: if a step stays blocked after 2-3 DIFFERENT approaches, stop and report what worked, what didn't, and the exact blocking error. A clear partial result beats a burned budget.\n\nScratchpad Execution\nFor complex logical, mathematical, or data-parsing questions, write and run a temporary Rust script with dev-code-evaluate_rust instead of guessing. Your \\`code\\` is compiled inside a function returning DataObject — the FINAL EXPRESSION must be a DataObject:\n    let mut out = DataObject::new();\n    out.put_int(\"result\", my_value as i64);\n    out\nPut use statements in \\`imports\\` (DataObject is automatic).\n\nAdvanced Native Orchestration\nYou can invoke any Newbound command from WITHIN an evaluate_rust script via let api = crate::api::new(); — chain tools, process large data, or run multi-step pipelines in one script instead of many chat rounds. Pass large intermediate values through DataStore::globals().get_object(\"AGENT_MEMORY\") or the runtime library rather than through this conversation.`;\n\n// Newbound meta types -> Rust types, for synthesized signatures (ported\n// from control_query's lookup_rust_api_data_type).\nconst RUST_TYPE = {\n  FLAT: \"DataObject\", JSONObject: \"DataObject\", JSONArray: \"DataArray\",\n  InputStream: \"DataBytes\", float: \"f64\", Integer: \"i64\", Boolean: \"bool\",\n  Any: \"Data\", NULL: \"DNull\",\n};\nconst rustType = (t) => RUST_TYPE[t] ?? \"String\";\n\n/** The context prompt, ported from control_query: an editing preamble plus\n    one fence per included piece, tagged the way the backend prompt always\n    tagged them. `included` = chatctx snapshot entries the user checked. */\nexport function contextBlock(included) {\n  const merged = {};\n  for (const p of included) Object.assign(merged, p.fields);\n  const { lib, ctl } = merged;\n  if (!lib && !ctl) return \"\";\n  let out = `We are editing the ${ctl} control in the ${lib} library.`;\n  for (const facet of [\"html\", \"css\", \"js\"]) {\n    const v = (merged[facet] ?? \"\").trim?.() ?? \"\";\n    if (v) out += `\\n\\n\\`\\`\\`${lib}:${ctl}.${facet}\\n${v}\\n\\`\\`\\``;\n  }\n  if (merged.code && merged.cmdname) {\n    const lang = merged.lang === \"rust\" ? \"rs\" : merged.lang === \"python\" ? \"py\" : merged.lang;\n    let signature = \"\";\n    if (merged.cmdparams) {\n      const ps = merged.cmdparams.map((p) =>\n        lang === \"rs\" ? `${p.name}: ${rustType(p.type)}` : p.name).join(\", \");\n      signature = lang === \"rs\"\n        ? `// fn ${merged.cmdname}(${ps}) -> ${rustType(merged.cmdreturn ?? \"String\")}\\n`\n        : `# def ${merged.cmdname}(${ps}):\\n`;\n    }\n    out += `\\n\\n\\`\\`\\`${lib}:${ctl}:${merged.cmdname}.${lang}\\n${signature}${merged.code.trim()}\\n\\`\\`\\``;\n  }\n  if (merged.flow && merged.cmdname) {\n    out += `\\n\\n\\`\\`\\`${lib}:${ctl}:${merged.cmdname}.flow\\n${merged.flow}\\n\\`\\`\\``;\n  }\n  return out;\n}\n\nexport const clamp = (s, n = 2000) =>\n  s.length <= n ? s : s.slice(0, n) + `\\n…[${s.length - n} chars clipped]`;\n\n/** MCP tool descriptors -> OpenAI function defs, enabled names only. */\nexport function toolDefs(mcpTools, enabledNames) {\n  const on = new Set(enabledNames);\n  return (mcpTools ?? [])\n    .filter((t) => on.has(t.name))\n    .map((t) => ({\n      type: \"function\",\n      function: {\n        name: t.name,\n        description: t.description ?? \"\",\n        parameters: t.inputSchema ?? { type: \"object\", properties: {} },\n      },\n    }));\n}\n\n// ── the tool model: defaults, meta-tools, gating ──────────\n\n// Attached-by-default: the read family (auto-run) plus the journaled\n// workhorses (each call confirm-gated). Everything else stays reachable\n// through call_command. The picker stores per-user add/remove overrides.\nexport const DEFAULT_TOOLS = [\n  \"dev-code-read_control_facet\", \"dev-code-read_command\",\n  \"dev-code-read_flow_body\", \"dev-code-list_control_patches\",\n  \"dev-code-list_libraries\", \"dev-code-list_controls\",\n  \"dev-code-list_commands\", \"dev-code-list_assets\",\n  \"dev-code-search_commands\",\n  \"dev-code-patch_control_facet\", \"dev-code-patch_command_body\",\n  \"dev-code-upsert_command\", \"dev-code-write_flow_body\",\n  \"dev-code-invoke_command\", \"dev-code-evaluate_rust\",\n];\n\n/** The always-attached meta-tools: discovery + the gateway. */\nexport const META_TOOL_DEFS = [\n  {\n    type: \"function\",\n    function: {\n      name: \"find_tools\",\n      description: \"Search ALL platform commands (not just attached tools) by keywords against their names and descriptions. Returns matches with their authorization tier. Use this before concluding a capability is missing.\",\n      parameters: { type: \"object\",\n        properties: { query: { type: \"string\", description: \"Keywords, e.g. 'delete asset' or 'rust eval'\" } },\n        required: [\"query\"] },\n    },\n  },\n  {\n    type: \"function\",\n    function: {\n      name: \"describe_tool\",\n      description: \"Full descriptor (description + JSON Schema of arguments) for one platform command by its lib-ctl-cmd name. Use before call_command when unsure of the arguments.\",\n      parameters: { type: \"object\",\n        properties: { name: { type: \"string\", description: \"Tool name, e.g. dev-code-delete_asset\" } },\n        required: [\"name\"] },\n    },\n  },\n  {\n    type: \"function\",\n    function: {\n      name: \"call_command\",\n      description: \"Invoke ANY platform command by its lib-ctl-cmd name — attached or not. Arguments are validated against the command's schema; mutating commands stop for the user's confirmation like every other call.\",\n      parameters: { type: \"object\",\n        properties: {\n          name: { type: \"string\", description: \"Tool name, e.g. dev-code-delete_asset\" },\n          args: { type: \"object\", description: \"The command's arguments, per its schema\" },\n        },\n        required: [\"name\", \"args\"] },\n    },\n  },\n];\n\nconst READ_TOOL_PREFIXES = [\n  \"list\", \"read\", \"get\", \"search\", \"describe\", \"lib_info\", \"check\",\n  \"current\", \"info\", \"peers\", \"libs\", \"apps\", \"assets\", \"asset\", \"lookup\",\n];\n\n/** Authorization tier for a catalog entry: \"auto\" (read — runs directly)\n    or \"confirm\" (stops at the typed confirm). The groups convention wins\n    when present — a command whose MCP tags include agent-auto or\n    agent-confirm is classified by the owner (describe() forwards groups\n    into tags once the flowlang side does; empty today, forward-compatible).\n    Fallback: the read-prefix heuristic on the command name. */\nexport function gateFor(name, entry) {\n  const tags = entry?.tags ?? [];\n  if (tags.includes(\"agent-confirm\")) return \"confirm\";\n  if (tags.includes(\"agent-auto\")) return \"auto\";\n  const cmd = parseToolName(name)?.cmd ?? name;\n  return READ_TOOL_PREFIXES.some((p) => cmd === p || cmd.startsWith(p + \"_\"))\n    ? \"auto\" : \"confirm\";\n}\n\n/** Light client-side check of args against a catalog inputSchema — enough\n    for the model to self-correct: missing required keys and gross type\n    mismatches, reported together. Null = fine. */\nexport function schemaComplaints(schema, args) {\n  if (!schema || typeof args !== \"object\" || args === null) return null;\n  const problems = [];\n  for (const req of schema.required ?? []) {\n    if (!(req in args)) problems.push(`missing required argument '${req}'`);\n  }\n  const kinds = { string: \"string\", number: \"number\", boolean: \"boolean\" };\n  for (const [k, v] of Object.entries(args)) {\n    const spec = schema.properties?.[k];\n    if (!spec) continue;\n    if (spec.type in kinds && typeof v !== kinds[spec.type]) {\n      problems.push(`argument '${k}' should be a ${spec.type}`);\n    } else if (spec.type === \"object\" && (typeof v !== \"object\" || v === null || Array.isArray(v))) {\n      problems.push(`argument '${k}' should be an object`);\n    } else if (spec.type === \"array\" && !Array.isArray(v)) {\n      problems.push(`argument '${k}' should be an array`);\n  